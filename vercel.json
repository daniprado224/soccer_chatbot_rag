{
  "builds": [
    {
      "src": "api/query.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["data/processed/chunks.json", "data/processed/embeddings_*.npy", "src/**"]
      }
    },
    {
      "src": "api/minilm/query.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["data/processed/chunks.json", "data/processed/embeddings_*.npy", "src/**"]
      }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/minilm/(.*)", "dest": "api/minilm/query.py" },
    { "src": "/api/(.*)", "dest": "api/query.py" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
