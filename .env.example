# Anthropic Claude API key -- required for the LangGraph relevance grader
# and answer generation nodes.
ANTHROPIC_API_KEY=

# Claude model used for grading + generation.
CLAUDE_MODEL=claude-sonnet-5

# Embedding backend: "spacy" (default, local word vectors, no API cost,
# no external model download beyond the one-time `pip install` of the
# en_core_web_md wheel) or "openai" (requires OPENAI_API_KEY and network
# access to api.openai.com).
EMBEDDING_BACKEND=spacy
SPACY_MODEL=en_core_web_md

# Only used when EMBEDDING_BACKEND=openai.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chroma persistence directory.
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=soccer_laws

# Retrieval
RETRIEVAL_TOP_K=5
RELEVANCE_MIN_RELEVANT=1
