# LLM backend for the LangGraph relevance grader, query rewriter, and
# answer generation nodes: "claude" (default, per the original spec --
# requires Anthropic Console credits) or "gemini" (free tier via
# aistudio.google.com, no payment method required -- see src/llm.py for
# the tradeoff of using this instead of Claude).
LLM_BACKEND=claude

# --- Claude (used when LLM_BACKEND=claude) ---
ANTHROPIC_API_KEY=

# Only needed if your key is scoped to the organization rather than a
# specific workspace (Anthropic Console > Organization settings >
# Workspaces) -- an org-scoped key is rejected without this header.
ANTHROPIC_WORKSPACE_ID=

CLAUDE_MODEL=claude-sonnet-5
CLAUDE_GRADER_MODEL=claude-haiku-4-5-20251001

# --- Gemini (used when LLM_BACKEND=gemini) ---
# Get a free key at https://aistudio.google.com/apikey -- no billing setup
# required for the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Embedding backend: "spacy" (default, local word vectors, no API cost, no
# external model download beyond the one-time `pip install` of the
# en_core_web_md wheel), "minilm" (a real sentence-transformer run locally
# via fastembed/ONNX -- needs network access to huggingface.co the first
# time it runs, to download the model weights), or "openai" (requires
# OPENAI_API_KEY and network access to api.openai.com). The deployed web
# app lets users pick spacy vs minilm per-question rather than fixing one
# via this env var -- see src/embeddings.py and api/query.py.
EMBEDDING_BACKEND=spacy
SPACY_MODEL=en_core_web_md

# Only used when EMBEDDING_BACKEND=minilm.
MINILM_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Where fastembed caches the downloaded ONNX model. Leave blank locally;
# defaults to /tmp/fastembed_cache automatically when running on Vercel.
FASTEMBED_CACHE_DIR=

# Only used when EMBEDDING_BACKEND=openai.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chroma persistence directory.
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=soccer_laws

# Retrieval
RETRIEVAL_TOP_K=5
RELEVANCE_MIN_RELEVANT=1
